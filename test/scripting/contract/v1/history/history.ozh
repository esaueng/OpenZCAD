  targetBodyId: #body_5c167992-21de-40dd-b800-50e2414f095b,
  script: {
    id: "openzcad.contract/rounded-tray",
    version: "1.0.0",
    api: 1,
    source: """script "openzcad.contract/rounded-tray" "1.0.0" api 1 {
  input round: length = `5 mm`
  input wall: length = `2 mm`
  pick corners: edges 4 = edges().type("line").axis("z")
  step fillet { edges: #corners, radius: `round` }
  pick top: face = faces().normal("z").max("z")
  step shell { faces: #top, thickness: `wall` }
}
""",
    digest: "6cb4fb393128347dfd69e6a9ad374412238ed3d6f2ca035c0f909339ee133f61",
  },
  inputs: { wall: `width / 20` },
}
