ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('The SAME physical cube authored as a 1x1x1 inch cube through CONVERSION_BASED_UNIT(''INCH''). Must read 16387.064 mm3, identical to b-unit-mm-cube. A kernel that ignores the conversion reads 1.'),'2;1');
FILE_NAME('b-unit-inch-cube.step','2026-01-01T00:00:00',('OpenZCAD parity corpus'),('OpenZCAD'),'OpenZCAD parity corpus authoring','OpenZCAD','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
