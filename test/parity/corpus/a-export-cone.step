DATA;
/* corpus: a-export-cone
   BrepKit export of an r10 h10 cone. Carries the CONICAL_SURFACE
   half-angle in radians — the control for the degree variants in (b).

   Generated by exporting through a kernel adapter. Do not hand-edit;
   rerecord with OPENZCAD_WRITE_PARITY_CORPUS=1 (see corpus/README.md).
*/
#1 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#2 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#3 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#4 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07), #1, 'distance_accuracy_value', 'confusion accuracy');
#5 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#4)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#1,#2,#3)) REPRESENTATION_CONTEXT('Context3D','3D Context with UNIT and UNCERTAINTY') );
#6 = APPLICATION_CONTEXT('configuration controlled 3D design of mechanical parts and assemblies');
#7 = MECHANICAL_CONTEXT('', #6, 'mechanical');
#8 = APPLICATION_PROTOCOL_DEFINITION('international standard', 'config_control_design', 1994, #6);
#9 = PRODUCT('brepkit_solid', 'brepkit_solid', '', (#7));
#10 = PRODUCT_DEFINITION_FORMATION('', '', #9);
#11 = PRODUCT_DEFINITION_CONTEXT('part definition', #6, 'design');
#12 = PRODUCT_DEFINITION('design', '', #10, #11);
#13 = CARTESIAN_POINT('', (1.000000000000000E1, 0., 0.));
#14 = VERTEX_POINT('', #13);
#15 = CARTESIAN_POINT('', (0., 0., 0.));
#16 = DIRECTION('', (0., 0., 1.000000000000000E0));
#17 = DIRECTION('', (0., 1.000000000000000E0, 0.));
#18 = AXIS2_PLACEMENT_3D('', #15, #16, #17);
#19 = CIRCLE('', #18, 1.000000000000000E1);
#20 = EDGE_CURVE('', #14, #14, #19, .T.);
#21 = ORIENTED_EDGE('', *, *, #20, .T.);
#22 = CARTESIAN_POINT('', (0., 0., 1.000000000000000E1));
#23 = VERTEX_POINT('', #22);
#24 = CARTESIAN_POINT('', (1.000000000000000E1, 0., 0.));
#25 = DIRECTION('', (-7.071067811865475E-1, 0., 7.071067811865475E-1));
#26 = VECTOR('', #25, 1.414213562373095E1);
#27 = LINE('', #24, #26);
#28 = EDGE_CURVE('', #14, #23, #27, .T.);
#29 = ORIENTED_EDGE('', *, *, #28, .T.);
#30 = ORIENTED_EDGE('', *, *, #28, .F.);
#31 = EDGE_LOOP('', (#21, #29, #30));
#32 = FACE_OUTER_BOUND('', #31, .T.);
#33 = CARTESIAN_POINT('', (0., 0., 1.000000000000000E1));
#34 = DIRECTION('', (0., 0., -1.000000000000000E0));
#35 = DIRECTION('', (0., -1.000000000000000E0, 0.));
#36 = AXIS2_PLACEMENT_3D('', #33, #34, #35);
#37 = CONICAL_SURFACE('', #36, 0.0E0, 7.853981633974483E-1);
#38 = ADVANCED_FACE('', (#32), #37, .T.);
#39 = ORIENTED_EDGE('', *, *, #20, .F.);
#40 = EDGE_LOOP('', (#39));
#41 = FACE_OUTER_BOUND('', #40, .T.);
#42 = CARTESIAN_POINT('', (0., 0., 0.));
#43 = DIRECTION('', (0., 0., -1.000000000000000E0));
#44 = DIRECTION('', (0., -1.000000000000000E0, 0.));
#45 = AXIS2_PLACEMENT_3D('', #42, #43, #44);
#46 = PLANE('', #45);
#47 = ADVANCED_FACE('', (#41), #46, .T.);
#48 = CLOSED_SHELL('', (#38, #47));
