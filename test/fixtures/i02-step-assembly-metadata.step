#14=NEXT_ASSEMBLY_USAGE_OCCURRENCE('Blue link occurrence','Blue link occurrence','',#10,#12,$);
#15=COLOUR_RGB('Safety red',0.8,0.1,0.1);
#16=COLOUR_RGB('Ocean blue',0.1,0.2,0.8);
