{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "openzcad-web",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "pnpm --filter @openzcad/web exec vite --port ${PORT:-5199} --strictPort"
      ],
      "autoPort": true,
      "port": 5199
    },
    {
      "name": "openzcad-preview",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "pnpm --filter @openzcad/web exec vite preview --port ${PORT:-4199} --strictPort"
      ],
      "autoPort": true,
      "port": 4199
    }
  ]
}
