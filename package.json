{
  "name": "openzcad",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.8.0",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @openzcad/web dev",
    "build": "pnpm --filter @openzcad/web build",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint apps packages test types --ext .ts,.tsx",
    "format": "prettier --write .",
    "deploy:beta": "pnpm --filter @openzcad/web deploy:beta"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/three": "^0.176.0",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.0",
    "vitest": "^3.1.1"
  }
}
