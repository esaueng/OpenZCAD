{
  "name": "openzcad",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.0",
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "scripts": {
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "brand:check": "node scripts/generate-brand-assets.mjs --check",
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @openzcad/web dev",
    "dev:desktop": "pnpm --filter @openzcad/desktop dev",
    "build": "node scripts/verify-remus-artifacts.mjs && pnpm --filter @openzcad/web build && node scripts/report-bundle-sizes.mjs --check",
    "build:desktop": "pnpm --filter @openzcad/desktop build",
    "build:desktop:app": "pnpm --filter @openzcad/desktop build:app",
    "build:report": "pnpm --filter @openzcad/web build && node scripts/report-bundle-sizes.mjs",
    "perf:remus-wasm": "node scripts/measure-remus-wasm-load.mjs",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit",
    "test": "vitest run && pnpm --filter @openzcad/web test",
    "test:full": "pnpm test:unit:full && pnpm test:web:full",
    "test:unit:full": "vitest run --config vitest.full.config.ts",
    "test:web:full": "pnpm --filter @openzcad/web test:full",
    "test:coverage": "vitest run --config vitest.full.config.ts --coverage",
    "test:web": "pnpm --filter @openzcad/web test",
    "test:parity-corpus": "vitest run --config test/parity/vitest.corpus.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:full": "playwright test --config playwright.full.config.ts",
    "lint": "node --max-old-space-size=6144 node_modules/eslint/bin/eslint.js apps packages test types --ext .ts,.tsx",
    "format": "prettier --write .",
    "selfhost:check": "node scripts/validate-deployment-config.mjs --config wrangler.selfhost.jsonc --target selfhost",
    "deploy:selfhost": "pnpm selfhost:check && pnpm build && pnpm --filter @openzcad/web exec wrangler d1 migrations apply DB --remote --config ../../wrangler.selfhost.jsonc && pnpm --filter @openzcad/web exec wrangler deploy --config ../../wrangler.selfhost.jsonc",
    "deploy:beta": "pnpm --filter @openzcad/web deploy:beta",
    "audit:dependencies": "pnpm audit --audit-level=high"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@>=5.0.0 <5.0.12": "5.0.12",
      "nanoid@>=3.0.0 <3.3.18": "3.3.18",
      "sharp@<0.35.5": "0.35.5",
      "undici@>=7.0.0 <7.30.1": "7.30.1",
      "zod@<4.6.6": "4.6.6"
    },
    "patchedDependencies": {
      "three@0.186.1": "patches/three@0.186.1.patch"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@openzcad/io-dxf": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "occt-wasm": "5.4.1",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "wrangler": "4.155.0"
  }
}
