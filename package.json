{
  "name": "openzcad",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.8.0",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @openzcad/web dev",
    "build": "pnpm --filter @openzcad/web build",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:web": "pnpm --filter @openzcad/web test",
    "test:e2e": "playwright test",
    "lint": "eslint apps packages test types --ext .ts,.tsx",
    "format": "prettier --write .",
    "deploy:beta": "pnpm --filter @openzcad/web deploy:beta"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@>=5.0.0 <5.0.6": "5.0.6"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.1.2",
    "@types/three": "^0.176.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.7",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
