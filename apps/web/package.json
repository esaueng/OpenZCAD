{
  "name": "@openzcad/web",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "vite --mode desktop --host 127.0.0.1 --port 1420 --strictPort",
    "build": "vite build",
    "build:desktop": "vite build --mode desktop",
    "preview": "vite preview",
    "predeploy:beta": "node ../../scripts/validate-deployment-config.mjs --config ../../wrangler.jsonc --target official",
    "deploy:beta": "node ../../scripts/apply-beta-migrations.mjs && wrangler deploy --config ../../wrangler.jsonc && node ../../scripts/verify-beta-deployment.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src worker vite.config.ts vitest.config.ts --ext .ts,.tsx"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@openzcad/ai-contracts": "workspace:*",
    "@openzcad/cloudflare-adapters": "workspace:*",
    "@openzcad/command-system": "workspace:*",
    "@openzcad/document-core": "workspace:*",
    "@openzcad/geometry": "workspace:*",
    "@openzcad/io-freecad": "workspace:*",
    "@openzcad/io-shapr": "workspace:*",
    "@openzcad/io-step": "workspace:*",
    "@openzcad/io-stl": "workspace:*",
    "@openzcad/kernel-adapter": "workspace:*",
    "@openzcad/persistence": "workspace:*",
    "@openzcad/shared": "workspace:*",
    "@openzcad/viewport": "workspace:*",
    "@tauri-apps/api": "^2.12.0",
    "lucide-react": "^1.48.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "vite": "^8.2.2",
    "vite-plugin-wasm": "3.6.0",
    "wrangler": "^4.143.0",
    "@cloudflare/vite-plugin": "^1.62.0",
    "@vitejs/plugin-react": "^6.0.5"
  }
}
