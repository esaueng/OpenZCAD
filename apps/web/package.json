{
  "name": "@openzcad/web",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "vite --mode desktop --host 127.0.0.1 --port 1420 --strictPort",
    "build": "vite build",
    "build:desktop": "vite build --mode desktop",
    "preview": "vite preview",
    "predeploy:beta": "node ../../scripts/validate-deployment-config.mjs --config ../../wrangler.jsonc --target official",
    "deploy:beta": "wrangler d1 migrations apply openzcad-beta --remote --config ../../wrangler.jsonc && wrangler deploy --config ../../wrangler.jsonc && node ../../scripts/verify-beta-deployment.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src worker vite.config.ts vitest.config.ts --ext .ts,.tsx"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@openzcad/ai-contracts": "workspace:*",
    "@openzcad/cloudflare-adapters": "workspace:*",
    "@openzcad/command-system": "workspace:*",
    "@openzcad/document-core": "workspace:*",
    "@openzcad/geometry": "workspace:*",
    "@openzcad/io-step": "workspace:*",
    "@openzcad/io-stl": "workspace:*",
    "@openzcad/kernel-adapter": "workspace:*",
    "@openzcad/persistence": "workspace:*",
    "@openzcad/shared": "workspace:*",
    "@openzcad/viewport": "workspace:*",
    "@tauri-apps/api": "^2.11.1",
    "@vitejs/plugin-react": "^6.0.5",
    "lucide-react": "^1.31.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.2",
    "vite": "^8.2.1",
    "vite-plugin-wasm": "3.6.0",
    "wrangler": "^4.123.0"
  }
}
