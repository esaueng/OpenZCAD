# Local Vite development reads this required secret from the launching shell,
# .env, or a populated .dev.vars file. Never commit a populated secret file.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
AI_MODEL=openai/gpt-5.6-terra

# Required only for encrypted per-user API tokens in Settings. Generate a
# base64-encoded 32-byte key, keep it secret, and use the same key after restarts.
# SETTINGS_ENCRYPTION_KEY=

# Generic secret alternative: AI_API_KEY=
# Optional attribution: AI_SITE_URL=http://localhost:5173
# Optional attribution: AI_APP_NAME=OpenZCAD

# Direct OpenAI alternative: AI_PROVIDER=openai and OPENAI_API_KEY=
# For another Responses-compatible provider, set AI_PROVIDER=responses-compatible
# plus AI_BASE_URL and either AI_API_KEY or OPENAI_API_KEY.
# Local Wrangler uses AUTH_MODE=development from wrangler.jsonc, so email-code
# secrets are not needed for normal local CAD development.
#
# Beta email-code authentication requires Worker secrets AUTH_OTP_PEPPER and
# TURNSTILE_SECRET_KEY plus TURNSTILE_SITE_KEY, AUTH_EMAIL_FROM, a D1 binding,
# and an EMAIL sending binding in the deployed Wrangler configuration.
# AUTH_LEGACY_OWNER_EMAIL can map historical user_beta_dev projects to one
# verified owner email without rewriting document ownership.
