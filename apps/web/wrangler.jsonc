{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "openzcad-beta",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-04-12",
  "compatibility_flags": ["nodejs_compat"],
  // Cloudflare does not generate Preview URLs for Workers that implement a DO.
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    // Sweep expired D1 upload sessions only after their R2 object is gone.
    "crons": ["17 * * * *"]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ENVIRONMENT": "development",
    "AUTH_MODE": "development",
    "DESKTOP_AUTH_ENABLED": "true",
    "AI_PROVIDER": "openrouter",
    "AI_MODEL": "openai/gpt-5.6-terra",
    "AI_REASONING_EFFORT": "high",
    "PROJECT_SHARING_ENABLED": "false",
    "PROJECT_EDIT_LEASES_ENFORCED": "false"
  },
  // Local dev secrets live in .dev.vars (gitignored; see .dev.vars.example):
  // a provider key such as OPENROUTER_API_KEY is needed only for the assistant.
  // wrangler has no schema key to declare required secrets — this is
  // documentation only, not enforcement.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openzcad-dev",
      // TODO(peter): create dev DB and replace this intentionally invalid ID.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "openzcad-beta-artifacts"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PROJECT_ROOM",
        "class_name": "ProjectCollaborationRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ProjectCollaborationRoom"]
    }
  ]
}
