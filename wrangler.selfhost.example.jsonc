{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Copy this file to wrangler.selfhost.jsonc and replace every placeholder.
  // The local file is gitignored and must point only to resources you own.
  "account_id": "<YOUR_ACCOUNT_ID>",
  "name": "<YOUR_WORKER_NAME>",
  "main": "./apps/web/worker/index.ts",
  "compatibility_date": "2026-04-12",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/healthz", "/assets/freecadImportWorker-*"]
  },
  "vars": {
    "ENVIRONMENT": "beta",
    "AUTH_MODE": "email-code",
    "PRODUCTION_GUARD": "enabled",
    "AUTH_EMAIL_FROM": "<YOUR_AUTH_EMAIL_FROM>",
    "PROJECT_INVITATION_EMAIL_FROM": "<YOUR_AUTH_EMAIL_FROM>",
    "PUBLIC_APP_ORIGIN": "<YOUR_PUBLIC_APP_ORIGIN>",
    "AUTH_SESSION_DAYS": "30",
    "DESKTOP_AUTH_ENABLED": "false",
    "TURNSTILE_SITE_KEY": "<YOUR_TURNSTILE_SITE_KEY>",
    "AI_PROVIDER": "openrouter",
    "AI_MODEL": "minimax/minimax-m3.1-flash:free",
    "AI_REASONING_EFFORT": "high",
    "AI_DEPLOYMENT_FREE_ENABLED": "true",
    "PROJECT_SHARING_ENABLED": "true",
    "PROJECT_EDIT_LEASES_ENFORCED": "true",
    "PROJECT_PERSONAL_SYNC_ENABLED": "true",
    // End-to-end encryption (ADR-024). Read "End-to-end encryption" in
    // docs/SELF_HOSTING.md first: nobody, operator included, can recover an
    // encrypted project whose owner loses every unlock method. Every flag
    // ships closed. Apply D1 migrations 0029-0043 (pnpm deploy:selfhost does),
    // then turn them on one deploy at a time, in this order; pnpm
    // selfhost:check refuses a flag whose predecessor is off.
    // 1. Account keys, devices, passkeys and the recovery key.
    "E2EE_KEYS_ENABLED": "false",
    // 2. Encrypted projects: the per-account "Encrypt new projects" opt-in.
    "E2EE_PROJECTS_ENABLED": "false",
    // 3. Owners encrypt their existing plaintext projects from Settings.
    "E2EE_MIGRATION_ENABLED": "false",
    // Phase 8 server gate. Keep off until browser rollout and outside review finish.
    "E2EE_DEFAULT_ON": "false"
    // Optional and beta-only: "E2EE_REVERSE_ENABLED": "true" (needs step 3)
    // lets an owner turn an unshared encrypted project back into plaintext.
    // A later release removes it.
    // Planned and not read yet: E2EE_PLAINTEXT_FROZEN (refuse plaintext writes).
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "<YOUR_D1_DATABASE_NAME>",
      "database_id": "<YOUR_D1_DATABASE_ID>",
      "migrations_dir": "apps/web/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "<YOUR_R2_BUCKET_NAME>"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["<YOUR_AUTH_EMAIL_FROM>"]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PROJECT_ROOM",
        "class_name": "ProjectCollaborationRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ProjectCollaborationRoom"]
    }
  ],
  "routes": [
    // Optional after the custom domain is active in your account:
    // { "pattern": "<YOUR_DOMAIN>", "custom_domain": true }
  ]
}
