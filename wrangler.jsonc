{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // This file contains non-secret resource identifiers used by the official
  // OpenZCAD deployment. They do not grant access to those resources.
  // Self-hosters must use the separate configuration in docs/SELF_HOSTING.md.
  "name": "openzcad",
  "main": "./apps/web/worker/index.ts",
  "compatibility_date": "2026-04-12",
  "compatibility_flags": ["nodejs_compat"],
  // Cloudflare does not generate Preview URLs for Workers that implement a DO.
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    // Sweep expired D1 upload sessions only after their R2 state is gone.
    "crons": ["17 * * * *"]
  },
  "ratelimits": [{"name":"GLIMPSE_USAGE_LIMITER", "namespace_id":"2026101501", "simple":{"limit":120,"period":60}}],
  // Production collection enabled; optional analytics still require browser consent.
  "services": [{"binding":"GLIMPSE", "service":"glimpse", "entrypoint":"OpenZCADIngest"}],
  // See docs/glimpse.md for consent controls and rollback.
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/healthz", "/assets/freecadImportWorker-*"]
  },
  "vars": {
    "GLIMPSE_BASIC_ENABLED": "true",
    "GLIMPSE_USAGE_ENABLED": "true",
    "ENVIRONMENT": "beta",
    "AUTH_MODE": "email-code",
    "PRODUCTION_GUARD": "enabled",
    "AUTH_EMAIL_FROM": "noreply@zcad.esau.app",
    "PROJECT_INVITATION_EMAIL_FROM": "noreply@zcad.esau.app",
    "PUBLIC_APP_ORIGIN": "https://zcad.app",
    "AUTH_SESSION_DAYS": "30",
    "DESKTOP_AUTH_ENABLED": "true",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAD_j6Y7NvXKtcxNX",
    "AI_PROVIDER": "openrouter",
    "AI_MODEL": "minimax/minimax-m3.1-flash:free",
    "AI_REASONING_EFFORT": "high",
    "AI_DEPLOYMENT_FREE_ENABLED": "true",
    // Collaboration is open to every authenticated beta account. Authorization
    // still comes from project ownership/membership, and editor writes still
    // require the persisted project-wide lease.
    "PROJECT_SHARING_ENABLED": "true",
    "PROJECT_EDIT_LEASES_ENFORCED": "true",
    "PROJECT_PERSONAL_SYNC_ENABLED": "true",
    // End-to-end encryption keys (ADR-024 Phase 3) stay closed. Apply D1
    // migration 0029 to production before turning this on, or the routes
    // answer 503; E2EE_CANARY_EMAILS (a secret) opens them for named accounts.
    "E2EE_KEYS_ENABLED": "false",
    // Encrypted projects (ADR-024 Phase 4) stay closed too. They need the key
    // routes for the account and D1 migrations 0031 and 0032 applied first.
    "E2EE_PROJECTS_ENABLED": "false",
    // Moving existing projects to encrypted storage (ADR-024 Phase 7) stays
    // closed as well: it needs encrypted projects and D1 migration 0042, and
    // migrating real projects needs its own production authorization.
    "E2EE_MIGRATION_ENABLED": "false",
    // The beta-only reverse path (ADR-024 Phase 7, slice 7-3), turning an
    // encrypted project back into plaintext, stays closed too. It needs
    // migration open and D1 migration 0043; Phase 8 deletes it.
    "E2EE_REVERSE_ENABLED": "false",
    // Encryption by default (ADR-024 Phase 8, slice 8-1) stays closed: no
    // plaintext project creation, plaintext sharing, opt-out or reverse path.
    // It needs the outside review confirmed done, and E2EE_KEYS_ENABLED,
    // E2EE_PROJECTS_ENABLED and E2EE_MIGRATION_ENABLED on, before it is set.
    "E2EE_DEFAULT_ON": "false",
    // Assistant rollout flags live here, not in the dashboard: a deploy
    // replaces dashboard variables with this block. Each one exposes its
    // operation in the model's output schema, and every one compiles to a
    // command the UI already ships, is checked against the digest, and is
    // exact-preflighted before it applies. Set one to "false" (or remove it)
    // to withdraw that operation without a code change.
    // AI_PATCH_HOLE_CONTROL_ENABLED stays off: its bore measurements are not
    // in the digest, so the model cannot author it; the app's own
    // "Parameterize the mounting holes" suggestion covers it without a flag.
    "AI_PATCH_DIRECT_EDIT_ENABLED": "true",
    "AI_PATCH_GROWING_HOLDER_ENABLED": "true",
    "AI_PATCH_FACE_SKETCH_ENABLED": "true",
    "AI_PATCH_MULTI_PROFILE_EXTRUDE_ENABLED": "true",
    "AI_PATCH_MIRROR_ENABLED": "true",
    "AI_PATCH_SHELL_ENABLED": "true",
    "AI_PATCH_SOLID_OFFSET_ENABLED": "true",
    "AI_PATCH_PARTIAL_REVOLVE_ENABLED": "true",
    "AI_PATCH_DATUM_PLANE_ENABLED": "true",
    "AI_PATCH_DATUM_GEOMETRY_ENABLED": "true"
  },
  // Secrets a deployment cannot run without (set with `wrangler secret put`;
  // wrangler has no schema key to declare them, so this is documentation only):
  //   AUTH_OTP_PEPPER, TURNSTILE_SECRET_KEY, SETTINGS_ENCRYPTION_KEY,
  //   AI_IDENTITY_PEPPER
  // PREMIUM_USER_EMAILS is a server secret listing manually granted Premium accounts.
  // OPENROUTER_API_KEY supplies the built-in free assistant. All verified
  // accounts are eligible while AI_DEPLOYMENT_FREE_ENABLED is true and the
  // configured model is an OpenRouter :free model. Paid models still require
  // AI_DEPLOYMENT_ALLOWED_EMAILS or Premium membership.
  // PROJECT_COLLABORATION_CANARY_EMAILS is not required while the global beta
  // rollout above is enabled. It remains an optional scoped fallback if those
  // flags are closed again.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openzcad-beta",
      "database_id": "7263c6f1-8781-40d1-a0fa-ea03ce874ef2",
      "migrations_dir": "apps/web/migrations"
    }
  ],
  // Private R2 storage for import artifacts and namespaced project objects.
  // This binds the existing beta bucket; resource creation remains a separate
  // operator-controlled step and is never performed by deployment scripts.
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "openzcad-beta-artifacts"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@zcad.esau.app"]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PROJECT_ROOM",
        "class_name": "ProjectCollaborationRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ProjectCollaborationRoom"]
    }
  ]
}
