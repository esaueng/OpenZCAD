{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "openzcad",
  "main": "./apps/web/worker/index.ts",
  "compatibility_date": "2026-04-12",
  "compatibility_flags": ["nodejs_compat"],
  // Cloudflare does not generate Preview URLs for Workers that implement a DO.
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ENVIRONMENT": "beta",
    "AUTH_MODE": "email-code",
    "PRODUCTION_GUARD": "enabled",
    "AUTH_EMAIL_FROM": "noreply@zcad.esau.app",
    "PROJECT_INVITATION_EMAIL_FROM": "noreply@zcad.esau.app",
    "PUBLIC_APP_ORIGIN": "https://zcad.esau.app",
    "AUTH_SESSION_DAYS": "30",
    "DESKTOP_AUTH_ENABLED": "true",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAD_j6Y7NvXKtcxNX",
    "AI_PROVIDER": "openai",
    "AI_MODEL": "gpt-5.6-sol",
    "AI_REASONING_EFFORT": "high",
    // Collaboration is open to every authenticated beta account. Authorization
    // still comes from project ownership/membership, and editor writes still
    // require the persisted project-wide lease.
    "PROJECT_SHARING_ENABLED": "true",
    "PROJECT_EDIT_LEASES_ENFORCED": "true",
    "PROJECT_PERSONAL_SYNC_ENABLED": "true",
    "AI_GLOBAL_DAILY_REQUEST_LIMIT": "100",
    "AI_GLOBAL_DAILY_COST_LIMIT_UNITS": "400"
  },
  // Secrets a deployment cannot run without (set with `wrangler secret put`;
  // wrangler has no schema key to declare them, so this is documentation only):
  //   AUTH_OTP_PEPPER, TURNSTILE_SECRET_KEY, SETTINGS_ENCRYPTION_KEY,
  //   AI_IDENTITY_PEPPER
  // AI_DEPLOYMENT_ALLOWED_EMAILS is deliberately absent: it is the allowlist
  // for spending the deployment's own provider key, and
  // `deploymentAssistantAllowed` fails closed when it is unset, so a
  // deployment without it simply offers no deployment-funded AI.
  // PROJECT_COLLABORATION_CANARY_EMAILS is not required while the global beta
  // rollout above is enabled. It remains an optional scoped fallback if those
  // flags are closed again.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openzcad-beta",
      "database_id": "7263c6f1-8781-40d1-a0fa-ea03ce874ef2",
      "migrations_dir": "apps/web/migrations"
    }
  ],
  // Private R2 storage for import artifacts and namespaced project objects.
  // This binds the existing beta bucket; resource creation remains a separate
  // operator-controlled step and is never performed by deployment scripts.
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "openzcad-beta-artifacts"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@zcad.esau.app"]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PROJECT_ROOM",
        "class_name": "ProjectCollaborationRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ProjectCollaborationRoom"]
    }
  ]
}
